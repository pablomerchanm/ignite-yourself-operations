{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.igniteyourself.co" }],
      "destination": "https://igniteyourself.co/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/igy-mobius" }
  ]
}
